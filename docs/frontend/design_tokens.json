      "h2": { "value": { "fontSize": 24, "fontWeight": 600, "lineHeight": 32 }, "type": "typography" },
      "h3": { "value": { "fontSize": 20, "fontWeight": 600, "lineHeight": 28 }, "type": "typography" },
      "body": { "value": { "fontSize": 16, "fontWeight": 400, "lineHeight": 24 }, "type": "typography" },
      "button": { "value": { "fontSize": 14, "fontWeight": 600, "lineHeight": 20 }, "type": "typography" },
      "caption": { "value": { "fontSize": 12, "fontWeight": 400, "lineHeight": 16 }, "type": "typography" }
    },

    "size": {
      "space-2": { "value": 2, "type": "sizing" },
      "space-4": { "value": 4, "type": "sizing" },
