    "elevation": {
      "elevation-1": { "value": { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "rgba(13,27,26,0.06)" }, "type": "boxShadow" },
      "elevation-2": { "value": { "x": 0, "y": 4, "blur": 8, "spread": 0, "color": "rgba(13,27,26,0.08)" }, "type": "boxShadow" },
      "elevation-3": { "value": { "x": 0, "y": 12, "blur": 24, "spread": 0, "color": "rgba(13,27,26,0.10)" }, "type": "boxShadow" }
