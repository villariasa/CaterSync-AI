{
  "$schema": "https://raw.githubusercontent.com/six7/figma-tokens/main/schema/tokens-schema.json",
  "name": "CaterSync Tokens",
  "version": "2",
  "tokens": {
    "color": {
      "primary-900": { "value": "#00332A", "type": "color" },
      "primary-700": { "value": "#00594F", "type": "color" },
      "primary-600": { "value": "#00695C", "type": "color" },
      "primary-400": { "value": "#33A792", "type": "color" },
      "primary-100": { "value": "#E6F6F2", "type": "color" },

      "accent-600": { "value": "#FFC107", "type": "color" },
      "accent-400": { "value": "#FFE082", "type": "color" },

      "neutral-900": { "value": "#0D1B1A", "type": "color" },
      "neutral-700": { "value": "#29403E", "type": "color" },
      "neutral-500": { "value": "#4D6664", "type": "color" },
      "neutral-300": { "value": "#BFCFCB", "type": "color" },
      "neutral-100": { "value": "#F5F7F6", "type": "color" },

      "success-600": { "value": "#2E7D32", "type": "color" },
      "warning-600": { "value": "#F57C00", "type": "color" },
